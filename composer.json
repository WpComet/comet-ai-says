{
  "name": "wpcomet/comet-ai-says",
  "description": "Generate contextual AI product descriptions on-the-fly for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "WpComet",
      "homepage": "https://wpcomet.com"
    }
  ],
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "WpComet\\AISays\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WpComet\\AISays\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "test": "phpunit"
  }
}
